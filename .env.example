# Variáveis da logística do Odoo (feat/logistica-odoo). SÓ SERVIDOR: nenhuma
# delas tem prefixo NEXT_PUBLIC_ e nenhuma vai para o navegador.
# Valores reais das chaves: com o Pedro (não commitar). Ver docs/LOGISTICA-ODOO.md.

# Ponte HTTP do Odoo (motor de carga/NF 5117/estoque)
ODOO_BRIDGE_URL=https://atendimento.lojasmaia.com.br/api/odoo
# Chave por perfil (HMAC do JWT_SECRET da ponte; 16 caracteres hex)
ODOO_KEY_LOGISTICA=
ODOO_KEY_MOTORISTA=
# Opcional: timeout de leitura em ms (padrão 20000; "sair em rota" usa 120000)
ODOO_BRIDGE_TIMEOUT_MS=

# Empresa (res.company) que a tela do CD abre por padrão (?empresa= troca)
ODOO_COMPANY_ID_PADRAO=13
# Empresas onde procurar a carga do motorista (vírgula). Vazio = a padrão.
ODOO_COMPANY_IDS_MOTORISTA=13

# De-para motorista (drivers.name) -> hr.employee.id do Odoo, enquanto a
# tabela odoo_motorista_map não existe. Sem entrada, casa por nome exato.
# Ex.: {"Everton": 12, "Samuel": {"employeeId": 15}}
ODOO_MOTORISTA_MAP=

# Base pública absoluta para o link da foto do comprovante (vai no texto da
# baixa no Odoo). Vazio = origem da requisição.
APP_PUBLIC_URL=
